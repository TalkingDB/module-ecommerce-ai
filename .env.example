CLIENT_MODE=direct
TDB_API_KEY=

# Consumed by PTClient/DSClient/STClient (constructed internally in DIRECT mode)
PT_HOST=
DS_HOST=
ST_HOST=

# Per-tenant store API credentials. Named <TENANT_ID upper>_STORE_API_UN /
# _PWD - see tenants.json for the list of configured tenant ids.
CASTER_CONCEPTS_STORE_API_UN=
CASTER_CONCEPTS_STORE_API_PWD=

# Override which tenants.json to load (defaults to the repo-root one).
EAI_TENANTS_CONFIG_PATH=
